{
    "name": "@repo/tld-crawler",
    "version": "1.0.0",
    "private": true,
    "description": "Utility for crawling IANA root DB to fetch WHOIS and RDAP data.",
    "type": "module",
    "main": "src/index.ts",
    "scripts": {
        "build": "bun build src/index.ts --outdir dist --target bun",
        "start": "bun run dist/index.js",
        "dev": "bun --hot src/index.ts",
        "test": "bun test",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "check-types": "tsc --noEmit"
    },
    "dependencies": {
        "@keyvhq/core": "^2.1.11",
        "axios": "^1.13.2",
        "cheerio": "^1.1.2",
        "pino": "^10.1.0",
        "pino-pretty": "^13.1.3"
    },
    "devDependencies": {
        "@repo/typescript-config": "*",
        "@types/cheerio": "^1.0.0",
        "axios-mock-adapter": "^2.1.0"
    }
}
